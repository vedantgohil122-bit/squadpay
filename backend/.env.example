# Copy this file to .env and fill in real values. NEVER commit .env.
PORT=5000
CLIENT_URL=http://localhost:5173

# --- OPTION A: local PostgreSQL ---
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/squadpay
DB_SSL=false

# --- OPTION B: Supabase (Project Settings -> Database -> Connection string) ---
# DATABASE_URL=postgresql://postgres.xxxx:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# DB_SSL=true

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Email (OTP for login/register/password reset) ---
# Free account at brevo.com -> Settings -> SMTP & API -> API Keys
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# --- Optional: AI captions on Squad Wrapped (console.anthropic.com) ---
ANTHROPIC_API_KEY=

# --- Optional: real push notifications (v6.1), works even with app closed ---
# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Leave blank to disable — the in-app notification bell still works without these.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com

# --- Optional: live Treasury payments via Razorpay (v6.7) ---
# 1. Sign up free at razorpay.com — Test Mode keys are instant, no KYC needed to start.
# 2. Dashboard -> Settings -> API Keys -> generate a Test Mode key pair.
# 3. Dashboard -> Settings -> Webhooks -> add a webhook:
#      URL:    https://your-render-backend.onrender.com/api/payments/webhook/razorpay
#      Events: payment.captured, payment.failed, order.paid
#    Razorpay shows you a webhook secret when you save it — that's RAZORPAY_WEBHOOK_SECRET below.
# Leave all three blank to disable online payments — manual/cash contribution logging still works.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- File uploads (v6.5) — Supabase Storage, same project as DATABASE_URL ---
# 1. Supabase dashboard -> your project -> Storage -> Create a new bucket
#    named "squadpay-uploads" (or match SUPABASE_STORAGE_BUCKET below),
#    and toggle it PUBLIC (uploaded photos/avatars need to be viewable
#    without auth — same as any other image hosting).
# 2. Project Settings -> API -> Project URL -> SUPABASE_URL
# 3. Project Settings -> API -> service_role key (NOT the anon key — this
#    needs write access) -> SUPABASE_SERVICE_KEY
# Without these set, avatar and memory-photo uploads will fail — everything
# else in the app works fine without them.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=squadpay-uploads
